# -------------------------------------------------------
# MULTI-USER MODE
# -------------------------------------------------------
# If ./config/users.conf exists, multi-user mode is active.
# Each user gets their own Samba share and Paperless API key.
# See config/users.conf.example for the format.
#
# In multi-user mode, the SMB_* and PAPERLESS_API_KEY variables
# below are ignored. PAPERLESS_URL and all other settings still apply.

# -------------------------------------------------------
# SINGLE-USER MODE (default, backwards-compatible)
# -------------------------------------------------------

# Paperless-NGX API Configuration
PAPERLESS_URL=https://your-paperless-instance.com
PAPERLESS_API_KEY=your-api-key-here
PAPERLESS_VERIFY_SSL=true
PAPERLESS_TAGS=

# Samba Configuration
SMB_USER=scanner
SMB_PASSWORD=securepassword
SMB_SHARE=scanner

# Document Processing
WHITELIST=pdf,jpg,png,bmp
ARCHIVE=true
UPLOAD_TIMEOUT=30
SCAN_SETTLE_TIME=5

# Note: this container always runs as a fixed UID/GID (65532:65532 by
# default -- the "distroless nonroot" convention, chosen to avoid colliding
# with a real interactive/sudo-capable host user) and never as root, not
# even briefly at startup. There is no PUID/PGID setting -- before the
# first start, make sure ./data and ./config are owned by (or writable by)
# that UID/GID on the host, e.g.:
#   mkdir -p data config && chown -R 65532:65532 data config
# To match your own host user instead (avoids the chown, at the cost of
# reintroducing the UID-collision consideration above), rebuild the image
# with --build-arg APP_UID=<uid> --build-arg APP_GID=<gid> and update
# compose.yaml's `user:` field to match.
